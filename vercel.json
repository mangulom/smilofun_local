{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "angular",
      "buildCommand": "npm run build",
      "outputDirectory": "dist/frontend/browser"
    },
    "backend": {
      "root": "backend/",
      "entrypoint": "main:app",
      "framework": "fastapi",
      "functions": {
        "app/main.py": {
          "maxDuration": 60
        }
      }
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
