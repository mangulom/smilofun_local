# Copia este archivo a .env y sustituye todos los secretos por valores persistentes.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./dentamia.db
SECRET_KEY=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_DE_32_BYTES_O_MAS
FERNET_KEY=REEMPLAZAR_POR_CLAVE_FERNET_PERSISTENTE
PAYLOAD_ENCRYPTION_ENABLED=true
